# --- NVIDIA build (OpenAI-compatible) ---
NVIDIA_API_KEY="nvapi-..."

# --- Dati retail ---
FMP_API_KEY="your_fmp_key"

# --- Configurazione motore ---
# lente metriche di default: value | growth | dividends | trading
RQE_LENS="value"
# valuta base dei totali di portafoglio (returns/rebalance)
RQE_BASE_CURRENCY="EUR"
# giorni di cache dei profili ETF justETF (0 = sempre fresco)
RQE_ETF_CACHE_DAYS="7"

# ruoli modello (vedi build.nvidia.com per gli id disponibili)
RQE_MODEL_ORCHESTRATOR="meta/llama-3.1-405b-instruct"
RQE_MODEL_EXTRACTOR="meta/llama-3.1-70b-instruct"

# --- Notifiche (monitor --notify): configura SOLO i canali che vuoi usare ---
# Email via Gmail (serve una "app password", NON la password normale:
#   Account Google -> Sicurezza -> Verifica in due passaggi -> Password per le app)
#RQE_SMTP_USER="tuoindirizzo@gmail.com"
#RQE_SMTP_PASSWORD="app-password-16-caratteri"
#RQE_NOTIFY_EMAIL_TO="tuoindirizzo@gmail.com"   # opzionale, default = SMTP_USER

# ntfy (push sul telefono, gratis: installa l'app ntfy e iscriviti al topic)
#RQE_NTFY_TOPIC="un-nome-topic-segreto-a-tua-scelta"

# Telegram (crea un bot con @BotFather, poi ricava il chat_id)
#RQE_TELEGRAM_BOT_TOKEN="123456:ABC-..."
#RQE_TELEGRAM_CHAT_ID="123456789"
